{
  "name": "chorpolice",
  "main": "expo-router/entry",
  "version": "5.6.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "clean": "npx rimraf node_modules android/build .expo && npm install",
    "lint": "expo lint -- --no-error-on-unmatched-pattern",
    "ts:check": "tsc --noEmit",
    "prebuild": "npx expo prebuild",
    "build:android:debug": "npx expo run:android --variant debug",
    "build:ios:debug": "npx expo run:ios --configuration Debug",
    "build:prod": "eas build --platform android --profile production",
    "build:dev": "eas build --platform android --profile development",
    "preview": "eas build --platform android --profile preview",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll",
    "update:prod": "eas update --branch production --message 'Quick fix'",
    "update:preview": "eas update --branch preview",
    "check:fingerprint": "expo-fingerprint",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.0.1",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "lucide-react-native": "^0.574.0",
    "moti": "^0.30.0",
    "nanoid": "^5.1.7",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-network-info": "^5.2.2",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-responsive-dimensions": "^3.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-udp": "^4.1.7",
    "react-native-worklets": "0.5.1",
    "react-native-zeroconf": "^0.14.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@types/react-native-zeroconf": "^0.13.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^54.0.10",
    "eslint": "^9.20.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-udp",
          "react-native-tcp-socket",
          "react-native-network-info"
        ]
      }
    }
  }
}
