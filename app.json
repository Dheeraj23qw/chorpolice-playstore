{
  "expo": {
    "name": "Chor Police",
    "slug": "chorpolice",
    "version": "2.0.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "scheme": "chorpolice",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050508",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050508"
    },
    "icon": "./assets/images/adaptive-icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/audio/*",
      "assets/gif/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/d2d7084f-7e5a-4b67-a860-dc2eddc33241",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.dheeraj.chorpolice",
      "userInterfaceStyle": "dark",
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "newArchEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050508"
      }
    },
    "extra": {
      "eas": {
        "projectId": "d2d7084f-7e5a-4b67-a860-dc2eddc33241"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-audio",
      "expo-file-system",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you set custom player avatars."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#DFDFDF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableHermes": true,
            "enableProguardInReleaseBuilds": true,
            "extraCompilerArgs": ["-Xjvm-default=all"],
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"],
              "exclude": [
                "**/LICENSE.txt",
                "**/NOTICE",
                "**/META-INF/*.py",
                "**/META-INF/*.txt",
                "**/META-INF/DEPENDENCIES"
              ]
            }
          }
        }
      ]
    ]
  }
}
