{
  "expo": {
    "name": "Chor Police",
    "slug": "chorpolice",
    "version": "2.0.0", // 🟢 Users see this as a Major Upgrade
    "orientation": "portrait",
    "scheme": "chorpolice",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050508",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050508"
    },
    "icon": "./assets/images/adaptive-icon.png",
    "runtimeVersion": "2.0.0", // 🟢 Keep this synced with your version
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/audio/*",
      "assets/gif/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/d2d7084f-7e5a-4b67-a860-dc2eddc33241",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "android": {
      "package": "com.dheeraj.chorpolice",
      "userInterfaceStyle": "dark",
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050508"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d2d7084f-7e5a-4b67-a860-dc2eddc33241"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-file-system",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you set custom player avatars."
        }
      ],
    ["expo-notifications", { "icon": "./assets/images/notification-icon.png", "color": "#050508" }],
      [
        "expo-build-properties",
        {
          "android": {
            "enableHermes": true,
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ]
  }
}