{
  "expo": {
    "name": "Chor Police",
    "slug": "chorpolice",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "chorpolice",
    "userInterfaceStyle": "light",
    "backgroundColor": "#050508",
    "icon": "./assets/images/adaptive-icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/audio/*",
      "assets/gif/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/d2d7084f-7e5a-4b67-a860-dc2eddc33241",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "android": {
      "package": "com.dheeraj.chorpolice",
      "userInterfaceStyle": "light",
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050508"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d2d7084f-7e5a-4b67-a860-dc2eddc33241"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-file-system",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you set custom player avatars."
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableHermes": true,
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}